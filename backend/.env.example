NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=library_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/library_db

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Email Configuration (Sỹ - Notification & EmailJob)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Thư viện <library@example.com>"

# Cron Jobs (set false to disable background jobs in test environments)
ENABLE_CRON_JOBS=true
